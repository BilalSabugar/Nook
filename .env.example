# ============================================================================
# NOOK PRODUCTION CONFIGURATION TEMPLATE
# ============================================================================
# IMPORTANT: Do NOT use example or placeholder values in deployments.
# Known sample/documentation strings are actively rejected at startup.
#
# Generate fresh secrets before starting Nook:
#   openssl rand -hex 32
# Or validate your environment configuration with:
#   npm run doctor
# ============================================================================

# 1. Machine / Owner API Key (Required; must be >= 16 characters with high entropy)
# Generate with: openssl rand -hex 32
NOOK_API_KEY=

# 2. Human Approver Password (Required for human-in-the-loop approvals; must be >= 12 chars and distinct from NOOK_API_KEY)
# Generate with: openssl rand -hex 24
NOOK_APPROVER_PASSWORD=

# 3. Sandbox Runner Shared HMAC Secret (Required; must be >= 32 chars with high character variety)
# Generate with: openssl rand -hex 32
SANDBOX_RUNNER_SECRET=

# 4. Trusted Reverse Proxy Count (0 when directly exposed or local; N when behind N trusted reverse proxies)
NOOK_TRUSTED_PROXY_COUNT=0

# Optional: Comma-separated list of allowed public Origins when behind a reverse proxy (e.g. https://nook.example.com)
# NOOK_ALLOWED_ORIGINS=

# 5. Optional Model Provider Keys (Can also be configured at runtime in the encrypted UI vault)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
