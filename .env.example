# Nook Environment Configuration
# Copy this file to .env.local and populate your credentials

# Default Port (Default: 3000)
PORT=3000

# Authentication & Human-in-the-Loop Safeguards (Required in Production)
# Machine API key for coworker operations and API access (>=8 characters)
NOOK_API_KEY=nook-production-api-key-change-this-32bytes
# Owner login password (alternative or alias to NOOK_API_KEY, >=8 characters)
NOOK_PASSWORD=
# Human approver credential for approving sensitive terminal executions (>=12 characters, MUST be distinct from NOOK_API_KEY/NOOK_PASSWORD)
NOOK_APPROVER_PASSWORD=nook-human-approver-secret-password-32bytes
# Number of trusted reverse proxies in front of Nook (0 = direct, N = use Nth X-Forwarded-For from right)
NOOK_TRUSTED_PROXY_COUNT=0

# Sandbox Runner Security (Required in Production)
# High-entropy secret shared between Nook and the sandbox runner daemon (>=16 characters)
SANDBOX_RUNNER_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SANDBOX_SERVICE_URL=http://127.0.0.1:4000
NOOK_SANDBOX_TIMEOUT_MS=30000
NOOK_ALLOW_SHELL_EXEC=true

# Multi-Provider LLM Credentials
# Leave blank to use local Ollama or the built-in Autonomous Demo Engine
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama Configuration (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default Model Selection (e.g. gemini-1.5-flash, gpt-4o-mini, claude-3-5-sonnet-20241022)
DEFAULT_MODEL=gemini-1.5-flash
