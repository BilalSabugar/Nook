{
  "name": "nook",
  "version": "1.0.0",
  "description": "An open-source workspace for persistent AI coworkers with sandboxed computers, living spaces, and human-in-the-loop review safeguards (Vibe-coded with Next.js & MCP).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ai",
    "vibe-coded",
    "vibe-coding",
    "ai-coworkers",
    "copilotkit",
    "opendots",
    "model-context-protocol",
    "mcp",
    "sandboxed-computer",
    "autonomous-agents",
    "nextjs",
    "react-19",
    "typescript"
  ],
  "homepage": "https://github.com/BilalSabugar/Nook#readme",
  "bugs": {
    "url": "https://github.com/BilalSabugar/Nook/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BilalSabugar/Nook.git"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 src/__tests__/*.test.mjs",
    "worker": "node --experimental-strip-types bin/worker.mjs",
    "sandbox-runner": "node bin/sandbox-runner.mjs",
    "doctor": "node bin/doctor.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.4.3",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
